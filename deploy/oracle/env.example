# /etc/clipforge/env — root-owned, mode 600.
# These values are loaded by systemd before the app starts.
# Never commit this file with real keys.

# Runtime directories. Keep these outside the checkout so an update cannot
# delete a job or a rendered clip.
CLIPFORGE_DATA_DIR=/var/lib/clipforge
CLIPFORGE_OUTPUTS_DIR=/var/lib/clipforge/outputs
CLIPFORGE_DOWNLOADS_DIR=/var/lib/clipforge/downloads

# The public VM is not a tailnet. This disables the tailnet-only gate.
# It does NOT add authentication; put Caddy basic auth, a VPN, or an
# identity-aware proxy in front before sharing the URL.
TAILSCALE_ONLY=false

# Set this to the URL users will open. It is used for share links and OAuth
# callback URLs.
CLIPFORGE_PUBLIC_URL=http://127.0.0.1:8000

# AI provider. DeepSeek is the primary.
DEEPSEEK_API_KEY=
# Optional backup / alternate provider.
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# First run on a 4-vCPU VM: small is the sensible speed/quality trade-off.
# Change to medium or large on a bigger machine.
CLIPFORGE_WHISPER_MODEL=small

# A 22-minute source is fine at the default 120. Raise this for long podcasts.
# CLIPFORGE_MAX_SOURCE_MIN=240

# Optional S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS, Wasabi).
# Without it, finished media lives on this VM's disk only.
CLIPFORGE_S3_ENDPOINT=
CLIPFORGE_S3_BUCKET=
CLIPFORGE_S3_ACCESS_KEY=
CLIPFORGE_S3_SECRET_KEY=
CLIPFORGE_S3_REGION=auto
CLIPFORGE_S3_PREFIX=clipforge

# Optional: keep the local copy after a verified upload (uses more disk).
# CLIPFORGE_OFFLOAD_DELETE_LOCAL=0
